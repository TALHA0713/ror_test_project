<section class="bg-gradient-to-br from-gray-900 via-gray-800 to-indigo-900 text-white">
  <div class="max-w-7xl mx-auto px-6 py-24 text-center">
    <h1 class="text-5xl font-bold mb-6">
      Ticket Tracking System
    </h1>

    <p class="max-w-2xl mx-auto text-lg text-gray-300 mb-10">
      Manage projects, assign roles, track tickets, and keep your team organized
      with a clean and practical workflow.
    </p>
</section>

<section class="max-w-7xl mx-auto px-6 py-20">
  <div class="text-center mb-14">
    <h2 class="text-3xl font-bold text-gray-900">
      What this system helps with
    </h2>
    <p class="text-gray-600 mt-3">
      Built for teams that need a simple way to organize work.
    </p>
  </div>

  <div class="grid gap-8 md:grid-cols-3">
    <div class="bg-white p-8 rounded-2xl shadow-sm border">
      <div class="text-4xl mb-4">📁</div>
      <h3 class="text-xl font-semibold mb-3">Project Management</h3>
      <p class="text-gray-600">
        Create projects and keep related tickets, members, and tasks organized.
      </p>
    </div>

    <div class="bg-white p-8 rounded-2xl shadow-sm border">
      <div class="text-4xl mb-4">🎫</div>
      <h3 class="text-xl font-semibold mb-3">Ticket Tracking</h3>
      <p class="text-gray-600">
        Track bugs, issues, feature requests, and task progress in one place.
      </p>
    </div>

    <div class="bg-white p-8 rounded-2xl shadow-sm border">
      <div class="text-4xl mb-4">👥</div>
      <h3 class="text-xl font-semibold mb-3">Role Assignment</h3>
      <p class="text-gray-600">
        Assign users to roles so everyone knows their responsibility.
      </p>
    </div>
  </div>
</section>

<section class="bg-gray-100">
  <div class="max-w-7xl mx-auto px-6 py-20">
    <div class="bg-white rounded-3xl shadow-sm border p-10 md:p-14 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        Start organizing your workflow
      </h2>

      <p class="text-gray-600 max-w-2xl mx-auto mb-8">
        This project will grow into a complete ticket tracking system with
        users, projects, tickets, comments, attachments, and permissions.
      </p>

      <%= link_to "Explore Projects", projects_path,
        class: "inline-block bg-gray-900 hover:bg-gray-800 text-white px-6 py-3 rounded-lg font-medium" %>
    </div>
  </div>
</section>