<% if project.errors.any? %>
  <div class="bg-red-500/10 border border-red-400/30 text-red-200 p-4 rounded-lg mb-5 text-sm">
    <ul class="list-disc list-inside">
      <% project.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form_with model: project, class: "space-y-6" do |form| %>
  <div>
    <%= form.label :name, "Project Name", class: "block text-sm font-medium text-gray-200 mb-2" %>
    <%= form.text_field :name,
          placeholder: "Enter project name",
          class: "w-full rounded-lg border border-white/10 bg-white/10 px-4 py-3 text-white placeholder-gray-400 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30" %>
  </div>
  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-200 mb-2" %>
    <%= form.text_area :description,
          rows: 4,
          placeholder: "Enter project description",
          class: "w-full rounded-lg border border-white/10 bg-white/10 px-4 py-3 text-white placeholder-gray-400 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30" %>
  </div>
  <div class="space-y-5">
    <h2 class="text-xl font-bold text-white">Project Members</h2>
    <!-- Creator block -->
    <div class="rounded-xl border border-indigo-400/20 bg-indigo-400/10 p-4">
      <p class="text-white font-semibold">
        <%= current_user.name %>
        <span class="text-indigo-300 text-sm">(Project Creator)</span>
      </p>
      <div class="mt-4 flex flex-wrap gap-5">
        <span class="inline-flex px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-400/20 text-sm">
          Manager
        </span>
        <% creator_member = project.project_members.find_by(user: current_user) %>
        <% creator_roles = creator_member&.roles&.pluck(:name) || [] %>
        <label class="flex items-center gap-3 text-gray-200 text-sm cursor-pointer">
          <%= check_box_tag "creator_roles[]",
                "developer",
                creator_roles.include?("developer"),
                class: "h-5 w-5 rounded border-white/20 bg-white/10 text-indigo-500 focus:ring-indigo-400" %>
          Developer
        </label>
        <label class="flex items-center gap-3 text-gray-200 text-sm cursor-pointer">
          <%= check_box_tag "creator_roles[]",
                "qa",
                creator_roles.include?("qa"),
                class: "h-5 w-5 rounded border-white/20 bg-white/10 text-indigo-500 focus:ring-indigo-400" %>
          QA
        </label>
      </div>
    </div>
    <!-- Other users -->
    <% users.each do |user| %>
      <% member = project.project_members.find_by(user: user) %>
      <% roles = member&.roles&.pluck(:name) || [] %>
      <div class="rounded-xl border border-white/10 bg-white/10 p-4">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <div>
            <label class="flex items-center gap-3 text-white font-semibold cursor-pointer">
              <%= check_box_tag "project_user_ids[]",
                    user.id,
                    member.present?,
                    id: "project_user_#{user.id}",
                    class: "h-5 w-5 rounded border-white/20 bg-white/10 text-indigo-500 focus:ring-indigo-400 user-select-checkbox",
                    data: { user_id: user.id } %>
              <%= user.name %>
            </label>
            <p class="text-gray-400 text-sm mt-1 ml-8">
              <%= user.email %>
            </p>
          </div>
          <div class="flex flex-wrap gap-5 sm:pt-1">
            <label class="flex items-center gap-3 text-gray-200 text-sm cursor-pointer">
              <%= check_box_tag "user_roles[#{user.id}][]",
                    "developer",
                    roles.include?("developer"),
                    id: "developer_role_#{user.id}",
                    disabled: member.blank?,
                    class: "h-5 w-5 rounded border-white/20 bg-white/10 text-indigo-500 focus:ring-indigo-400 role-checkbox role-for-user-#{user.id}" %>
              Developer
            </label>
            <label class="flex items-center gap-3 text-gray-200 text-sm cursor-pointer">
              <%= check_box_tag "user_roles[#{user.id}][]",
                    "qa",
                    roles.include?("qa"),
                    id: "qa_role_#{user.id}",
                    disabled: member.blank?,
                    class: "h-5 w-5 rounded border-white/20 bg-white/10 text-indigo-500 focus:ring-indigo-400 role-checkbox role-for-user-#{user.id}" %>
              QA
            </label>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="flex flex-col sm:flex-row gap-3 pt-4">
    <%= form.submit project.new_record? ? "Create Project" : "Update Project",
          class: "bg-indigo-500 hover:bg-indigo-600 text-white px-6 py-3 rounded-xl font-semibold cursor-pointer transition shadow-lg shadow-indigo-500/20" %>
    <%= link_to "Back",
          projects_path,
          class: "text-center bg-white/10 hover:bg-white/20 text-white px-6 py-3 rounded-xl font-semibold border border-white/10 transition" %>
  </div>
<% end %>
<script>
  document.addEventListener("turbo:load", setupProjectRoleCheckboxes);
  document.addEventListener("DOMContentLoaded", setupProjectRoleCheckboxes);

  function setupProjectRoleCheckboxes() {
    document.querySelectorAll(".user-select-checkbox").forEach(function(userCheckbox) {
      userCheckbox.addEventListener("change", function() {
        const userId = this.dataset.userId;
        const roleCheckboxes = document.querySelectorAll(".role-for-user-" + userId);

        roleCheckboxes.forEach(function(roleCheckbox) {
          roleCheckbox.disabled = !userCheckbox.checked;

          if (!userCheckbox.checked) {
            roleCheckbox.checked = false;
          }
        });
      });
    });
  }
</script>