<% if project.errors.any? %>
  <div class="bg-red-500/10 border border-red-400/30 text-red-200 p-4 rounded-lg mb-5 text-sm">
    <ul class="list-disc list-inside">
      <% project.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% users_json    = users.map { |u| { id: u.id, name: u.name, email: u.email, role: u.role } }.to_json %>
<% selected_ids  = project.persisted? ? project.project_members.where.not(user_id: current_user.id).pluck(:user_id) : [] %>
<% selected_json = selected_ids.to_json %>

<%= form_with model: project, class: "space-y-6" do |form| %>
  <div>
    <%= form.label :name, "Project Name", class: "block text-sm font-medium text-gray-200 mb-2" %>
    <%= form.text_field :name,
          placeholder: "Enter project name",
          class: "w-full rounded-lg border border-white/10 bg-white/10 px-4 py-3 text-white placeholder-gray-400 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30" %>
  </div>
  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-200 mb-2" %>
    <%= form.text_area :description,
          rows: 4,
          placeholder: "Enter project description",
          class: "w-full rounded-lg border border-white/10 bg-white/10 px-4 py-3 text-white placeholder-gray-400 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30" %>
  </div>

  <div class="space-y-4">
    <div>
      <h2 class="text-xl font-bold text-white">Project Members</h2>
      <p class="text-gray-400 text-sm mt-1">The project creator is always added as Manager. Search and select additional members below.</p>
    </div>

    <!-- Creator row (locked) -->
    <div class="rounded-xl border border-indigo-400/20 bg-indigo-400/10 p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-lg bg-indigo-500/20 text-indigo-300 flex items-center justify-center text-sm font-bold border border-indigo-400/20">
            <%= current_user.name.first.upcase %>
          </div>
          <div>
            <p class="text-white font-semibold text-sm">
              <%= current_user.name %>
            </p>
            <p class="text-gray-400 text-xs"><%= current_user.email %></p>
          </div>
        </div>
        <span class="inline-flex px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-400/20 text-sm">
          <%= current_user.role.capitalize %>
        </span>
      </div>
    </div>

    <!-- Searchable multi-select for remaining users -->
    <div
      data-controller="member-select"
      data-member-select-users-value="<%= users_json %>"
      data-member-select-selected-value="<%= selected_json %>"
      class="relative"
    >
      <!-- Selected pills -->
      <div class="flex flex-wrap gap-2 mb-3 min-h-[2rem]"
           data-member-select-target="pills"></div>

      <!-- Search input -->
      <div class="relative">
        <svg class="absolute left-3 top-3.5 h-4 w-4 text-gray-400 pointer-events-none"
             fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          type="text"
          placeholder="Search members by name..."
          autocomplete="off"
          data-member-select-target="search"
          data-action="input->member-select#filter focus->member-select#open keydown->member-select#onKeydown"
          class="w-full rounded-lg border border-white/10 bg-white/10 pl-10 pr-4 py-3 text-white placeholder-gray-400 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30"
        >
      </div>

      <!-- Dropdown panel — teleported to <body> by the Stimulus controller -->
      <div
        data-member-dropdown
        class="hidden rounded-xl border border-white/10 bg-white/10 backdrop-blur-xl shadow-2xl overflow-hidden max-h-64 overflow-y-auto"
      ></div>

      <!-- Hidden inputs submitted with the form -->
      <div data-member-select-target="inputs"></div>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row gap-3 pt-4">
    <%= form.submit project.new_record? ? "Create Project" : "Update Project",
          class: "bg-indigo-500 hover:bg-indigo-600 text-white px-6 py-3 rounded-xl font-semibold cursor-pointer transition shadow-lg shadow-indigo-500/20" %>
    <%= link_to "Back",
          projects_path,
          class: "text-center bg-white/10 hover:bg-white/20 text-white px-6 py-3 rounded-xl font-semibold border border-white/10 transition" %>
  </div>
<% end %>
