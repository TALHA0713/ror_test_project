<% content_for :page_header do %>
  <div class="flex items-center justify-between">
    <div>
      <%= link_to project_path(@project),
          class: "text-xs text-gray-500 hover:text-gray-300 flex items-center gap-1 mb-2 transition" do %>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Board
      <% end %>
      <h1 class="text-xl font-bold text-white">Edit Project</h1>
      <p class="text-gray-400 text-sm mt-0.5"><%= @project.name %></p>
    </div>
  </div>
<% end %>

<div class="px-8 py-6 space-y-5">
  <div class="max-w-3xl mx-auto">
    <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
      <%= render "form", project: @project, users: @users %>
    </div>
  </div>

  <div class="max-w-3xl mx-auto">
    <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
      <h2 class="text-base font-semibold text-white mb-4">Project Members</h2>
      <% if @project_members.any? %>
        <div class="space-y-2">
          <% @project_members.each do |member| %>
            <div class="flex items-center justify-between rounded-xl bg-white/5 border border-white/10 p-4">
              <div class="flex items-center gap-3">
                <div class="h-8 w-8 rounded-lg bg-indigo-500/20 text-indigo-300 flex items-center justify-center font-bold border border-indigo-400/20 text-xs">
                  <%= member.user.name.first.upcase %>
                </div>
                <div>
                  <p class="text-white text-sm font-semibold"><%= member.user.name %></p>
                  <p class="text-gray-400 text-xs"><%= member.user.email %></p>
                </div>
              </div>
              <% unless member.user == current_user %>
                <%= button_to "Remove",
                    remove_member_project_path(@project, user_id: member.user.id),
                    method: :delete,
                    data: { turbo_confirm: "Remove this member?" },
                    class: "bg-red-500/10 hover:bg-red-500/20 text-red-300 border border-red-400/20 px-3 py-1.5 rounded-lg text-sm cursor-pointer transition" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-sm">No members added yet.</p>
      <% end %>
    </div>
  </div>
</div>
