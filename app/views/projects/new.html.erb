<section class="min-h-[calc(100vh-132px)] bg-gradient-to-br from-gray-950 via-gray-900 to-indigo-950 px-4 py-10">
  <div class="max-w-3xl mx-auto">
    <div class="bg-white/10 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl p-8">
      <h1 class="text-3xl font-bold text-white mb-6">Create Project</h1>
      <% if @project.errors.any? %>
        <div class="bg-red-500/10 border border-red-400/30 text-red-200 p-4 rounded-lg mb-5 text-sm">
          <ul class="list-disc list-inside space-y-1">
            <% @project.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <%= render "form", project: @project, users: @users %>
    </div>
  </div>
</section>