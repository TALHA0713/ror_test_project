<% content_for :page_header do %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Project Board</p>
      <h1 class="text-xl font-bold text-white"><%= @project.name %></h1>
      <p class="text-gray-400 text-sm mt-0.5 max-w-xl truncate">
        <%= @project.description.presence || "No description provided." %>
      </p>
    </div>
    <div class="flex items-center gap-2 shrink-0 mt-0.5">
      <% if current_user == @project.created_by_user %>
        <%= link_to edit_project_path(@project),
            class: "bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-xl border border-white/10 text-sm transition" do %>
          Edit
        <% end %>
      <% end %>
      <%= link_to new_ticket_path(project_id: @project.id),
          class: "flex items-center gap-1.5 bg-indigo-500 hover:bg-indigo-600 text-white px-4 py-2 rounded-xl text-sm font-semibold transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        New Ticket
      <% end %>
    </div>
  </div>
<% end %>

<div class="flex items-start gap-4 p-6 overflow-x-auto">
  <% [
    ["open",        "Pending",     "bg-blue-400",   "text-blue-300",   "bg-blue-400/10 border-blue-400/30"],
    ["in_progress", "In Progress", "bg-yellow-400", "text-yellow-300", "bg-yellow-400/10 border-yellow-400/30"],
    ["resolved",    "Complete",    "bg-green-400",  "text-green-300",  "bg-green-400/10 border-green-400/30"],
    ["closed",      "Closed",      "bg-gray-400",   "text-gray-300",   "bg-gray-400/10 border-gray-400/30"]
  ].each do |status, label, dot_class, text_class, badge_class| %>

    <div class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.04] min-w-[260px] w-full max-w-xs">
      <!-- Column Header -->
      <div class="px-4 py-3 border-b border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full <%= dot_class %>"></span>
          <h3 class="text-sm font-semibold text-white"><%= label %></h3>
        </div>
        <span class="text-xs px-2 py-0.5 rounded-full border <%= badge_class %> <%= text_class %> font-medium tabular-nums">
          <%= @tickets_by_status[status].size %>
        </span>
      </div>
      <div class="p-3 space-y-2" data-kanban-column="<%= status %>">
        <% @tickets_by_status[status].each do |ticket| %>
          <%= render "tickets/kanban_card", ticket: ticket %>
        <% end %>
        <div class="<%= @tickets_by_status[status].any? ? 'hidden' : '' %> flex flex-col items-center justify-center py-5 text-center"
             data-empty-state>
          <p class="text-gray-600 text-xs mb-2">No tickets</p>
          <% if status == "open" %>
            <%= link_to new_ticket_path(project_id: @project.id),
                class: "flex items-center gap-1 text-xs text-indigo-400 hover:text-indigo-300 border border-indigo-400/30 hover:border-indigo-400/60 px-3 py-1.5 rounded-lg transition" do %>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              Create ticket
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
