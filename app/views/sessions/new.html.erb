<section class="min-h-[calc(100vh-132px)] flex items-center justify-center bg-gradient-to-br from-gray-950 via-gray-900 to-indigo-950 px-4 py-8">
  <div class="w-full max-w-md">
    <div class="bg-white/10 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl p-8">

      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-white">
          Welcome Back
        </h1>
        <p class="text-gray-300 mt-2 text-sm">
          Login to continue to Ticket Tracking
        </p>
      </div>

      <% if flash.now[:alert].present? || flash[:alert].present? %>
        <div class="bg-red-500/10 border border-red-400/30 text-red-200 p-4 rounded-lg mb-5 text-sm">
          <ul class="list-disc list-inside space-y-1">
            <% (flash.now[:alert] || flash[:alert]).split("\n").each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: login_path, method: :post, class: "space-y-5" do |form| %>
        <div>
          <%= form.label :email, class: "block text-sm font-medium text-gray-200 mb-2" %>
          <%= form.email_field :email,
                placeholder: "you@example.com",
                class: "w-full rounded-lg border border-white/10 bg-white/10 px-4 py-3 text-white placeholder-gray-400 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30" %>
        </div>

        <div>
          <%= form.label :password, class: "block text-sm font-medium text-gray-200 mb-2" %>
          <%= form.password_field :password,
                placeholder: "••••••••",
                class: "w-full rounded-lg border border-white/10 bg-white/10 px-4 py-3 text-white placeholder-gray-400 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30" %>
        </div>

        <%= form.submit "Login",
              class: "w-full rounded-lg bg-indigo-500 hover:bg-indigo-600 text-white py-3 font-semibold shadow-lg shadow-indigo-500/20 cursor-pointer transition" %>
      <% end %>

      <p class="mt-6 text-center text-sm text-gray-300">
        Don’t have an account?
        <%= link_to "Sign up", signup_path, class: "text-indigo-300 hover:text-indigo-200 font-medium" %>
      </p>

    </div>
  </div>
</section>