<% if notice %>
  <div class="mx-8 mt-4 rounded-xl border border-green-400/30 bg-green-500/10 px-4 py-3 text-green-200 text-sm shrink-0">
    <%= notice %>
  </div>
<% end %>
<% if alert %>
  <div class="mx-8 mt-4 rounded-xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-red-200 text-sm shrink-0">
    <%= alert %>
  </div>
<% end %>
