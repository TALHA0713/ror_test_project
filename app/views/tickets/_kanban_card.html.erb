<div class="group bg-white/10 hover:bg-white/[0.15] border border-white/10 hover:border-white/20 rounded-xl p-3 cursor-grab active:cursor-grabbing transition select-none"
     draggable="true"
     data-ticket-card
     data-ticket-id="<%= ticket.id %>">
  <!-- Top row: ticket label + priority -->
  <div class="flex items-center justify-between gap-2 mb-2">
    <span class="text-xs text-gray-500 font-mono shrink-0"><%= ticket.ticket_label %></span>
    <span class="text-xs px-2 py-0.5 rounded-full shrink-0 <%= ticket_priority_classes(ticket.priority) %>">
      <%= ticket.priority.capitalize %>
    </span>
  </div>

  <!-- Title (clickable) -->
  <%= link_to ticket_path(ticket), data: { turbo: false }, class: "block" do %>
    <p class="text-white text-sm font-medium leading-snug group-hover:text-indigo-200 transition break-words" style="overflow-wrap:anywhere">
      <%= ticket.title %>
    </p>
  <% end %>

  <!-- Bottom row: type badge + assignee -->
  <div class="mt-3 flex items-center justify-between gap-2">
    <span class="text-xs px-2 py-0.5 rounded-full bg-white/10 text-gray-300 border border-white/10">
      <%= ticket.ticket_type.humanize %>
    </span>
    <% if ticket.assigned_to_user %>
      <div class="flex items-center gap-1.5 shrink-0">
        <div class="w-5 h-5 rounded-md bg-indigo-500/20 text-indigo-300 flex items-center justify-center text-[10px] font-bold border border-indigo-400/20">
          <%= ticket.assigned_to_user.name.first.upcase %>
        </div>
        <span class="text-xs text-gray-400 truncate max-w-[80px]">
          <%= ticket.assigned_to_user.name.split.first %>
        </span>
      </div>
    <% else %>
      <span class="text-xs text-gray-600 shrink-0">Unassigned</span>
    <% end %>
  </div>
</div>
