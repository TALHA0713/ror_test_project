<% content_for :page_header do %>
  <div class="flex items-center justify-between">
    <div class="min-w-0">
      <%= link_to ticket_path(@ticket),
          class: "text-xs text-gray-500 hover:text-gray-300 flex items-center gap-1 mb-2 transition" do %>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Ticket
      <% end %>
      <div class="flex items-center gap-3">
        <span class="text-sm font-mono text-indigo-400 shrink-0"><%= @ticket.ticket_label %></span>
        <h1 class="text-xl font-bold text-white truncate"><%= @ticket.title %></h1>
      </div>
      <p class="text-gray-400 text-sm mt-0.5"><%= @ticket.project.name %></p>
    </div>
  </div>
<% end %>

<%= form_with model: @ticket, html: { multipart: true } do |form| %>
  <div class="flex gap-0 min-h-[calc(100vh-130px)]">

    <!-- LEFT: Main content -->
    <div class="flex-1 min-w-0 border-r border-white/10 p-8 space-y-6 overflow-y-auto">

      <!-- Title -->
      <div>
        <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Title</label>
        <%= form.text_field :title,
            placeholder: "Ticket title",
            class: "w-full bg-transparent border-0 border-b-2 #{@ticket.errors[:title].any? ? 'border-red-400/60' : 'border-white/10 focus:border-indigo-400'} px-0 py-2 text-xl font-semibold text-white placeholder-gray-600 outline-none transition" %>
        <%= field_error(@ticket, :title) %>
      </div>

      <!-- Description -->
      <div class="flex-1">
        <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Description</label>
        <%= form.text_area :description,
            rows: 14,
            placeholder: "Describe the issue, steps to reproduce, expected vs. actual behaviour…",
            class: "w-full bg-white/5 border #{@ticket.errors[:description].any? ? 'border-red-400/60' : 'border-white/10'} rounded-2xl px-5 py-4 text-gray-200 placeholder-gray-600 outline-none focus:border-indigo-400/60 resize-none leading-relaxed" %>
        <%= field_error(@ticket, :description) %>
      </div>

      <!-- Attachments -->
      <div>
        <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Attachments</label>
        <button type="button" data-ticket-files-add
                class="flex items-center gap-2 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white px-4 py-2.5 text-sm border border-white/10 hover:border-white/20 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
          </svg>
          Attach files
        </button>
        <%= form.file_field :files, multiple: true, name: "ticket[files][]", class: "hidden", data: { ticket_files: true } %>
        <div data-ticket-files-list class="mt-3 flex flex-wrap gap-2"></div>
      </div>
    </div>

    <!-- RIGHT: Properties sidebar -->
    <div class="w-72 shrink-0 p-6 space-y-1 overflow-y-auto">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Properties</p>

      <!-- Status -->
      <div class="group">
        <label class="block text-xs text-gray-500 mb-1.5">Status</label>
        <%= form.select :status,
            options_for_select([
              ["Pending",     "open"],
              ["In Progress", "in_progress"],
              ["Complete",    "resolved"],
              ["Closed",      "closed"]
            ], @ticket.status),
            {},
            class: "w-full rounded-xl border #{@ticket.errors[:status].any? ? 'border-red-400/60' : 'border-white/10'} bg-white/5 hover:bg-white/10 px-3 py-2.5 text-sm text-white outline-none focus:border-indigo-400 transition cursor-pointer" %>
        <%= field_error(@ticket, :status) %>
      </div>

      <!-- Priority -->
      <div class="pt-3">
        <label class="block text-xs text-gray-500 mb-1.5">Priority</label>
        <%= form.select :priority,
            options_for_select([
              ["Low",    "low"],
              ["Medium", "medium"],
              ["High",   "high"],
              ["Urgent", "urgent"]
            ], @ticket.priority),
            {},
            class: "w-full rounded-xl border #{@ticket.errors[:priority].any? ? 'border-red-400/60' : 'border-white/10'} bg-white/5 hover:bg-white/10 px-3 py-2.5 text-sm text-white outline-none focus:border-indigo-400 transition cursor-pointer" %>
        <%= field_error(@ticket, :priority) %>
      </div>

      <!-- Type -->
      <div class="pt-3">
        <label class="block text-xs text-gray-500 mb-1.5">Type</label>
        <%= form.select :ticket_type,
            options_for_select([
              ["Bug",     "bug"],
              ["Feature", "feature"],
              ["Task",    "task"]
            ], @ticket.ticket_type),
            {},
            class: "w-full rounded-xl border #{@ticket.errors[:ticket_type].any? ? 'border-red-400/60' : 'border-white/10'} bg-white/5 hover:bg-white/10 px-3 py-2.5 text-sm text-white outline-none focus:border-indigo-400 transition cursor-pointer" %>
        <%= field_error(@ticket, :ticket_type) %>
      </div>

      <div class="border-t border-white/10 my-2 pt-2"></div>

      <!-- Assignee -->
      <div>
        <label class="block text-xs text-gray-500 mb-1.5">Assigned To</label>
        <%= form.select :assigned_to_user_id,
            options_for_select((@assignable_users || []).map { |u| [u.name, u.id] }, @ticket.assigned_to_user_id),
            { prompt: "Unassigned" },
            class: "w-full rounded-xl border #{@ticket.errors[:assigned_to_user_id].any? ? 'border-red-400/60' : 'border-white/10'} bg-white/5 hover:bg-white/10 px-3 py-2.5 text-sm text-white outline-none focus:border-indigo-400 transition cursor-pointer" %>
        <%= field_error(@ticket, :assigned_to_user_id) %>
      </div>

      <!-- Due date -->
      <div class="pt-3">
        <label class="block text-xs text-gray-500 mb-1.5">Due Date</label>
        <%= form.date_field :due_date,
            class: "w-full rounded-xl border #{@ticket.errors[:due_date].any? ? 'border-red-400/60' : 'border-white/10'} bg-white/5 hover:bg-white/10 px-3 py-2.5 text-sm text-white outline-none focus:border-indigo-400 transition" %>
        <%= field_error(@ticket, :due_date) %>
      </div>

      <!-- Project (readonly) -->
      <div class="pt-3">
        <label class="block text-xs text-gray-500 mb-1.5">Project</label>
        <div class="rounded-xl border border-white/5 bg-white/5 px-3 py-2.5 text-sm text-gray-300">
          <%= @ticket.project.name %>
        </div>
      </div>

      <div class="border-t border-white/10 pt-5 mt-4 space-y-2">
        <%= form.submit "Save Changes",
              class: "w-full cursor-pointer bg-indigo-500 hover:bg-indigo-600 text-white px-4 py-2.5 rounded-xl font-semibold text-sm transition text-center" %>
        <%= link_to "Discard", ticket_path(@ticket),
              class: "block w-full text-center bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white px-4 py-2.5 rounded-xl text-sm border border-white/10 transition" %>
      </div>
    </div>
  </div>
<% end %>
