<% content_for :page_header do %>
  <div class="flex items-center justify-between">
    <div>
      <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Tickets</p>
      <h1 class="text-xl font-bold text-white">New Ticket</h1>
      <p class="text-gray-400 text-sm mt-0.5">Fill in the details to create a ticket.</p>
    </div>
  </div>
<% end %>

<div class="px-8 py-6">
  <div class="max-w-3xl mx-auto">
    <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
      <%= render "form", ticket: @ticket %>
    </div>
  </div>
</div>
