  <section class="min-h-[calc(100vh-132px)] flex items-center justify-center bg-gradient-to-br from-gray-950 via-gray-900 to-indigo-950 px-4 py-10">
    <div class="w-full max-w-2xl">
      <div class="bg-white/10 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl overflow-hidden">
        <!-- Header -->
        <div class="px-8 py-8 border-b border-white/10">
          <h1 class="text-3xl font-bold text-white">
            Edit Profile
          </h1>
          <p class="text-gray-300 mt-2 text-sm">
            Update user information and account status.
          </p>
        </div>
        <!-- Errors -->
        <% if @user.errors.any? %>
          <div class="mx-8 mt-6 bg-red-500/10 border border-red-400/30 text-red-200 p-4 rounded-xl text-sm">
            <ul class="list-disc list-inside space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <!-- Form -->
        <div class="p-8">
          <%= form_with model: @user, class: "space-y-6" do |form| %>
            <div>
              <%= form.label :name, class: "block text-sm font-medium text-gray-200 mb-2" %>
              <%= form.text_field :name,
                    class: "w-full rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-white placeholder-gray-400 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30" %>
            </div>
            <div>
              <%= form.label :email, class: "block text-sm font-medium text-gray-200 mb-2" %>
              <%= form.email_field :email,
                    class: "w-full rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-white placeholder-gray-400 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30" %>
            </div>
            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <%= form.label :password, "New Password", class: "block text-sm font-medium text-gray-200 mb-2" %>
                <%= form.password_field :password,
                      placeholder: "Leave blank to keep current",
                      class: "w-full rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-white placeholder-gray-400 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30" %>
              </div>
              <div>
                <%= form.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-200 mb-2" %>
                <%= form.password_field :password_confirmation,
                      placeholder: "Confirm new password",
                      class: "w-full rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-white placeholder-gray-400 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30" %>
              </div>
            </div>
            <div>
              <%= form.label :role, class: "block text-sm font-medium text-gray-200 mb-2" %>
              <%= form.select :role,
                    options_for_select([["Developer", "developer"], ["QA", "qa"], ["Manager", "manager"]], @user.role),
                    {},
                    class: "w-full rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-white outline-none focus:border-indigo-400" %>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-white/10 border border-white/10 px-4 py-4">
              <div>
                <p class="text-white font-medium">
                  Account Status
                </p>
                <p class="text-gray-400 text-sm">
                  Mark this user as active or inactive.
                </p>
              </div>
              <label class="flex items-center gap-2 text-gray-200">
                <%= form.check_box :is_active,
                      class: "h-5 w-5 rounded border-white/20 bg-white/10 text-indigo-500 focus:ring-indigo-400" %>
                Active
              </label>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 sm:justify-between pt-4">
              <%= form.submit "Update User",
                    class: "cursor-pointer bg-indigo-500 hover:bg-indigo-600 text-white px-6 py-3 rounded-xl font-semibold transition shadow-lg shadow-indigo-500/20" %>
              <%= link_to "Cancel",
                    user_path(@user),
                    class: "text-center bg-white/10 hover:bg-white/20 text-white px-6 py-3 rounded-xl font-semibold border border-white/10 transition" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>
