<section class="min-h-[calc(100vh-132px)] bg-gradient-to-br from-gray-950 via-gray-900 to-indigo-950 px-4 py-10">
  <div class="max-w-6xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">Users</h1>
      <p class="text-gray-400 mt-2">Manage users in your ticket tracking system.</p>
    </div>
    <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/10 backdrop-blur-xl shadow-2xl">
      <table class="min-w-full divide-y divide-white/10">
        <thead class="bg-white/10">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">User</th>
            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">Email</th>
            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">Status</th>
            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">Role</th>
            <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-300">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          <% @users.each do |user| %>
            <tr class="hover:bg-white/5 transition">
              <td class="px-6 py-5">
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-xl bg-indigo-500/20 text-indigo-300 flex items-center justify-center font-bold border border-indigo-400/20">
                    <%= user.name.first.upcase %>
                  </div>
                  <div>
                    <p class="font-semibold text-white"><%= user.name %></p>
                    <p class="text-xs text-gray-400">Joined <%= user.created_at.strftime("%d %b %Y") %></p>
                  </div>
                </div>
              </td>
              <td class="px-6 py-5 text-gray-300 break-all">
                <%= user.email %>
              </td>
              <td class="px-6 py-5">
                <% if user.is_active? %>
                  <span class="inline-flex px-3 py-1 rounded-full bg-green-400/10 text-green-300 border border-green-400/20 text-xs font-medium">
                    Active
                  </span>
                <% else %>
                  <span class="inline-flex px-3 py-1 rounded-full bg-red-400/10 text-red-300 border border-red-400/20 text-xs font-medium">
                    Inactive
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-5">
                <span class="inline-flex px-3 py-1 rounded-full bg-indigo-400/10 text-indigo-300 border border-indigo-400/20 text-xs font-medium">
                  <%= user.role.capitalize %>
                </span>
              </td>
              <td class="px-6 py-5 text-right">
                <div class="flex justify-end gap-2">
                  <%= link_to "View",
                        user_path(user),
                        class: "px-3 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white text-sm transition" %>
                  <%= link_to "Edit",
                        edit_user_path(user),
                        class: "px-3 py-2 rounded-lg bg-indigo-500 hover:bg-indigo-600 text-white text-sm transition" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @users.empty? %>
        <div class="text-center py-14">
          <p class="text-gray-300 font-medium">No other users found.</p>
          <p class="text-gray-500 text-sm mt-1">When new users sign up, they will appear here.</p>
        </div>
      <% end %>
    </div>
  </div>
</section>
