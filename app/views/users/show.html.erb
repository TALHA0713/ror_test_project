<% content_for :page_header do %>
  <div class="flex items-center justify-between">
    <div>
      <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Account</p>
      <h1 class="text-xl font-bold text-white">Profile</h1>
      <p class="text-gray-400 text-sm mt-0.5"><%= @user.email %></p>
    </div>
    <%= link_to edit_user_path(@user),
        class: "bg-indigo-500 hover:bg-indigo-600 text-white px-4 py-2 rounded-xl text-sm font-semibold transition" do %>
      Edit Profile
    <% end %>
  </div>
<% end %>

<div class="px-8 py-6">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
      <!-- Banner -->
      <div class="h-20 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500"></div>
      <!-- Avatar + name -->
      <div class="px-6 pb-6">
        <div class="-mt-10 flex items-end justify-between mb-6">
          <div class="h-20 w-20 rounded-2xl bg-white shadow-lg flex items-center justify-center border-4 border-gray-900">
            <span class="text-2xl font-bold text-indigo-600"><%= @user.name.first.upcase %></span>
          </div>
          <% if @user.is_active? %>
            <span class="px-3 py-1 bg-green-400/10 text-green-300 border border-green-400/20 rounded-full text-xs">Active</span>
          <% else %>
            <span class="px-3 py-1 bg-red-400/10 text-red-300 border border-red-400/20 rounded-full text-xs">Inactive</span>
          <% end %>
        </div>
        <h2 class="text-2xl font-bold text-white mb-5"><%= @user.name %></h2>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <p class="text-gray-400 text-xs mb-1">Name</p>
            <p class="text-white font-semibold text-sm"><%= @user.name %></p>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <p class="text-gray-400 text-xs mb-1">Email</p>
            <p class="text-white font-semibold text-sm break-all"><%= @user.email %></p>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <p class="text-gray-400 text-xs mb-2">Role</p>
            <span class="inline-flex px-2.5 py-0.5 rounded-full bg-indigo-400/10 text-indigo-300 border border-indigo-400/20 text-xs">
              <%= @user.role.capitalize %>
            </span>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <p class="text-gray-400 text-xs mb-1">Joined</p>
            <p class="text-white font-semibold text-sm"><%= @user.created_at.strftime("%d %b %Y") %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
