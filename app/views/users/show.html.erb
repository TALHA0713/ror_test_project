<section class="min-h-[calc(100vh-132px)] flex items-center justify-center bg-gradient-to-br from-gray-950 via-gray-900 to-indigo-950 px-4 py-10">
  <div class="w-full max-w-2xl">
    <div class="bg-white/10 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl overflow-hidden">
      <!-- Top banner -->
      <div class="h-28 bg-gradient-to-r from-indigo-500 to-purple-600"></div>
      <!-- Profile content -->
      <div class="px-8 pb-8">
        <!-- Avatar -->
        <div class="-mt-12 flex items-end justify-between">
          <div class="flex items-end gap-4">
            <div class="h-24 w-24 rounded-2xl bg-white shadow-lg flex items-center justify-center border-4 border-gray-900">
              <span class="text-3xl font-bold text-indigo-600">
                <%= @user.name.first.upcase %>
              </span>
            </div>
            <div class="pb-2">
              <h1 class="text-3xl font-bold text-white">
                <%= @user.name %>
              </h1>
            </div>
          </div>
          <% if @user.is_active? %>
            <span class="hidden sm:inline-flex px-3 py-1 bg-green-400/10 text-green-300 border border-green-400/20 rounded-full text-sm">
              Active
            </span>
          <% else %>
            <span class="hidden sm:inline-flex px-3 py-1 bg-red-400/10 text-red-300 border border-red-400/20 rounded-full text-sm">
              Inactive
            </span>
          <% end %>
        </div>
        <!-- Details -->
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-white/10 border border-white/10 p-5">
            <p class="text-gray-400 text-sm mb-1">Name</p>
            <p class="text-white font-semibold">
              <%= @user.name %>
            </p>
          </div>
          <div class="rounded-2xl bg-white/10 border border-white/10 p-5">
            <p class="text-gray-400 text-sm mb-1">Email</p>
            <p class="text-white font-semibold break-all">
              <%= @user.email %>
            </p>
          </div>
          <div class="rounded-2xl bg-white/10 border border-white/10 p-5">
            <p class="text-gray-400 text-sm mb-2">Status</p>
            <% if @user.is_active? %>
              <span class="inline-flex px-3 py-1 bg-green-400/10 text-green-300 border border-green-400/20 rounded-full text-sm">
                Active
              </span>
            <% else %>
              <span class="inline-flex px-3 py-1 bg-red-400/10 text-red-300 border border-red-400/20 rounded-full text-sm">
                Inactive
              </span>
            <% end %>
          </div>
          <div class="rounded-2xl bg-white/10 border border-white/10 p-5">
            <p class="text-gray-400 text-sm mb-1">Joined</p>
            <p class="text-white font-semibold">
              <%= @user.created_at.strftime("%d %b %Y") %>
            </p>
          </div>
          <div class="rounded-2xl bg-white/10 border border-white/10 p-5 sm:col-span-2">
            <p class="text-gray-400 text-sm mb-2">Role</p>
            <span class="inline-flex px-3 py-1 bg-indigo-400/10 text-indigo-300 border border-indigo-400/20 rounded-full text-sm">
              <%= @user.role.capitalize %>
            </span>
          </div>
        </div>
        <!-- Actions -->
        <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:justify-between">
          <%= link_to "Edit Profile",
                edit_user_path(@user),
                class: "text-center bg-indigo-500 hover:bg-indigo-600 text-white px-5 py-3 rounded-xl font-semibold transition shadow-lg shadow-indigo-500/20" %>
          <%= link_to "Back to Home",
                root_path,
                class: "text-center bg-white/10 hover:bg-white/20 text-white px-5 py-3 rounded-xl font-semibold border border-white/10 transition" %>
        </div>
      </div>
    </div>
  </div>
</section>
